# Credentials for the docs pipelines.
#
# Names are resolved by tools/cs-sync/src/lib/credentials.ts, which reads the
# canonical name first and falls back to the legacy one for a release, printing
# a warning when it does. Set the canonical names for anything new.
#
# Four stacks, so four pairs. Do not point one at another: CS Docs and API Docs
# are separate stacks that happen to share a naming pattern.

# ── Contentstack CS Docs Stack (Production) ─────────────────────────────────
# Canonical. Read by nav-tree, nav-apply, nav-verify, cms-pull-prod and the
# backfills.
CONTENTSTACK_DOCS_STACK_API_KEY=your_api_key_here
CONTENTSTACK_DOCS_STACK_MANAGEMENT_TOKEN=your_management_token_here

# Legacy aliases for the same stack, still readable for one release. Remove once
# every workflow passes the canonical names above.
# PROD_CSDOCS_STACK_API_KEY=your_api_key_here
# PROD_CSDOCS_STACK_MANAGEMENT_TOKEN=your_management_token_here

# Delivery token has no canonical equivalent yet. Used by the mirror-check
# scripts, not by the sync itself.
PROD_CSDOCS_STACK_DELIVERY_TOKEN=your_delivery_token_here

# ── Contentstack CS Docs Stack (Sandbox) ────────────────────────────────────
SANDBOX_CONTENTSTACK_DOCS_STACK_API_KEY=your_api_key_here
SANDBOX_CONTENTSTACK_DOCS_STACK_MANAGEMENT_TOKEN=your_management_token_here

# Legacy aliases for the Sandbox CS Docs stack.
# CSDOCS_SANDBOX_STACK_API_KEY=your_api_key_here
# CSDOCS_SANDBOX_MANAGEMENT_TOKEN=your_management_token_here

# ── Contentstack API Docs Stack (Production) ────────────────────────────────
# Separate stack. No canonical rename yet, on purpose.
PROD_APIDOCS_STACK_API_KEY=your_api_key_here
PROD_APIDOCS_STACK_MANAGEMENT_TOKEN=your_management_token_here
PROD_APIDOCS_STACK_DELIVERY_TOKEN=your_delivery_token_here

# ── Contentstack API Docs Stack (Sandbox) ──────────────────────────────────
APIDOCS_SANDBOX_STACK_API_KEY=your_api_key_here
APIDOCS_SANDBOX_MANAGEMENT_TOKEN=your_management_token_here

# ── Optional ────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=your_token_here

# Overrides, all optional:
#   PROD_SYNC_DRY_RUN=1              cms-pull-prod reports without staging
#   PROD_SYNC_MAX_DELETIONS=10       cap on the (currently disabled) delete pass
#   NAV_APPLY_MAX_DELETIONS=25       per-product cap in nav-apply
#   NAV_APPLY_MAX_TREE_AGE_HOURS=6   refuse a nav snapshot older than this
#   NAV_VERIFY_MAX_TREE_AGE_HOURS=6  same, for nav-verify
