# Contentstack API Docs Stack (Production)
PROD_APIDOCS_STACK_API_KEY=your_api_key_here
PROD_APIDOCS_STACK_DELIVERY_TOKEN=your_delivery_token_here

# Contentstack API Docs Stack (Sandbox)
APIDOCS_SANDBOX_STACK_API_KEY=your_api_key_here
APIDOCS_SANDBOX_MANAGEMENT_TOKEN=your_management_token_here

# Contentstack CS Docs Stack (Production)
PROD_CSDOCS_STACK_API_KEY=your_api_key_here
PROD_CSDOCS_STACK_DELIVERY_TOKEN=your_delivery_token_here
# Required by sandbox-to-prod-promote.ts and cms-pull-prod.ts (write/query access)
PROD_CSDOCS_STACK_MANAGEMENT_TOKEN=your_management_token_here

# Contentstack CS Docs Stack (Sandbox)
CSDOCS_SANDBOX_STACK_API_KEY=your_api_key_here
CSDOCS_SANDBOX_MANAGEMENT_TOKEN=your_management_token_here

# GitHub (optional - for webhook testing)
# GITHUB_TOKEN=your_token_here

# Playwright doc-walkthrough (tools/cs-sync/playwright/) — see TEAM_HANDOFF_GUIDE.md Step 4.5
# DEV_STACK_URL is normally supplied per-run via the VS Code task prompt (it changes
# every feature), not set here. CSDOCS_SANDBOX_DASHBOARD_URL is the fallback used when
# a feature has no dedicated Dev stack yet.
CSDOCS_SANDBOX_DASHBOARD_URL=https://app.contentstack.com/#!/stack/your_csdocs_sandbox_stack_uid/dashboard
DEV_STACK_LOGIN_EMAIL=your_test_account_email_here
DEV_STACK_LOGIN_PASSWORD=your_test_account_password_here
