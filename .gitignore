node_modules/
tools/cs-sync/node_modules/
*.log

# Local secrets (never commit)
.env
.env.local
tools/cs-sync/.env

# Backups and temporary files
cs-docs-backup/
*.tmp
*.bak

# cs-sync generated caches / run reports (never commit)
tools/cs-sync/.image-source-cache.json
tools/cs-sync/.image-source-coverage.json
tools/cs-sync/.image-inject-report.json
tools/cs-sync/.cms-pull-summary.json
tools/cs-sync/.cms-pull-prod-summary.json
# Prod-sync staging area. cms-pull-prod.ts writes generated files here rather
# than into cs-docs/, so prod-sync-open-prs.ts can apply one editor's bundle at
# a time onto a clean branch.
tools/cs-sync/.prod-sync-staging/
tools/cs-sync/prod-orphan-report.csv
tools/cs-sync/.nav-tree.json
tools/cs-sync/nav-audit/

# Playwright doc-walkthrough: local capture staging only — the images that
# actually ship are uploaded to CS-Docs Sandbox Assets and referenced by URL
tools/cs-sync/playwright/screenshots/
tools/cs-sync/test-results/
tools/cs-sync/playwright-report/

# Playwright doc-walkthrough: saved login session (see setup-auth.ts) — live
# session cookies, never commit
tools/cs-sync/playwright/.auth/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Build output
dist/
build/
cs-docs/orphan-docs/
